# Prefer the full connection string (Render/Supabase style).
# Leave empty to use the DB_* component variables below.
DATABASE_URL=

# Database connection settings (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dairy_db
DB_USER=dairy_user
DB_PASSWORD=change_me

# Application settings
APP_ENV=development
DEBUG=false
APP_NAME=Dairy AI Services
API_PREFIX=/api/v1

# dairy-backend integration (agent tool execution + auth)
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_USER=agent@dairy.ai
BACKEND_PASSWORD=change_me
AGENT_TOOL_TIMEOUT=30
AGENT_TOOL_MAX_RETRIES=3

# Forwarded-user authentication (Action Center)
# When set, only users of this organization may use the agent endpoints.
SERVICE_ORG_ID=